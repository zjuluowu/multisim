{
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/.host-out/build",
    "--background-index"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "files.associations": {
    "*.gn": "gn",
    "*.gni": "gn"
  },
  "testMate.cpp.test.advancedExecutables": [
    {
      "pattern": ".host-out/build/sim_test_host",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_test_host"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_component_test",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_component_test"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_primary_slot_entry_test",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_primary_slot_entry_test"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_g2a_query_test",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_g2a_query_test"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_upstream_query_test",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_upstream_query_test"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_primary_slot_real_test",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build",
        "SIM_HOST_BOOT_SLOT_COUNT": "2",
        "SIM028_INIT_MODEL": "single-active"
      },
      "runTask": {
        "before": [
          "Build sim_primary_slot_real_test"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_bootstrap_characterization",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build",
        "SIM_HOST_BOOT_SLOT_COUNT": "2",
        "SIM028_INIT_MODEL": "single-active"
      },
      "runTask": {
        "before": [
          "Build sim_bootstrap_characterization"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    },
    {
      "pattern": ".host-out/build/sim_test_target_host",
      "cwd": "${workspaceFolder}/.host-out",
      "maxTestsPerExecutable": 1,
      "parallelizationLimit": 1,
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/testmate-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build"
      },
      "runTask": {
        "before": [
          "Build sim_test_target_host"
        ]
      },
      "testGrouping": {
        "groupByExecutable": {
          "groupBySource": {}
        }
      }
    }
  ],
  "testMate.cpp.debug.configTemplate": {
    "type": "lldb",
    "request": "launch",
    "initCommands": [
      "settings set symbols.enable-external-lookup false"
    ],
    "program": "${exec}",
    "args": "${argsArray}",
    "cwd": "${cwd}",
    "env": "${envObj}"
  },
  "testMate.cpp.discovery.loadOnStartup": true,
  "testMate.cpp.discovery.testListCaching": true,
  "testMate.cpp.discovery.runtimeLimit": 30,
  "testMate.cpp.test.parallelExecutionLimit": 1
}
