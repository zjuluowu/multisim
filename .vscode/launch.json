{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SIM selected GoogleTest (WSL)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.host-out/build/${input:hostTarget}",
      "args": [
        "--gtest_filter=${input:gtestFilter}"
      ],
      "cwd": "${workspaceFolder}/.host-out",
      "env": {
        "LLVM_PROFILE_FILE": "${workspaceFolder}/.host-out/profiles/debug-%p.profraw",
        "LD_LIBRARY_PATH": "${workspaceFolder}/.host-out/build",
        "SIM_HOST_BOOT_SLOT_COUNT": "2"
      },
      "preLaunchTask": "Build All SIM Host"
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "Exact GoogleTest case (Testing panel selects it automatically)",
      "default": "SimTest.DualSimPinUnlockAfterWrongPin"
    },
    {
      "id": "hostTarget",
      "type": "pickString",
      "description": "Independently linked SUT slice",
      "options": [
        "sim_test_host",
        "sim_component_test",
        "sim_primary_slot_entry_test",
        "sim_g2a_query_test",
        "sim_upstream_query_test",
        "sim_test_target_host",
        "sim_primary_slot_real_test",
        "sim_bootstrap_characterization"
      ],
      "default": "sim_test_host"
    }
  ]
}
