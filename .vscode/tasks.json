  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "Exact GoogleTest case",
      "default": "AF2Primary.LiveDualSimSetPrimaryThroughLegacyEntry"
    },
    {
      "id": "scenarioId",
      "type": "promptString",
      "description": "Frozen dual-backend scenario ID",
      "default": "SIM028-LEGACY-C0-DUAL-PRIMARY0"
    },
    {
      "id": "breakpoint",
      "type": "promptString",
      "description": "Fully qualified LLDB function breakpoint",
