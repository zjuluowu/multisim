{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Build Host",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Build Real SIM Host",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "build",
        "--target",
        "sim_primary_slot_real_test",
        "sim_bootstrap_characterization"
      ]
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Run All Tests",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "all",
        "--ci"
      ]
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Run Selected Test",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "run",
        "--filter",
        "${input:gtestFilter}"
      ]
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Debug Selected Test",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "debug",
        "--filter",
        "${input:gtestFilter}"
      ]
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Check Device Wiring",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "device"
      ]
    },
    {
      "type": "process",
      "command": "/usr/bin/python3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "label": "Build All SIM Host",
      "args": [
        "-B",
        "telephony_core_service/services/multisim/test/scripts/test.py",
        "build"
      ]
    }
  ],
  "inputs": [
    {
      "id": "gtestFilter",
      "type": "promptString",
      "description": "Exact GoogleTest case (Testing panel selects it automatically)",
      "default": "SimTest.DualSimPinUnlockAfterWrongPin"
    }
  ]
}
