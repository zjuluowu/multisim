{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Testing Panel",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "editor",
        "--backend",
        "both"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build Legacy Host",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "build",
        "--backend",
        "legacy"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Target Host",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "build",
        "--backend",
        "target"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build All Host",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "build",
        "--backend",
        "both"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run Legacy Regression",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "run",
        "--backend",
        "legacy"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run Target Regression",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "run",
        "--backend",
        "target"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run Both Backends",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "run",
        "--backend",
        "both",
        "--filter",
        "${input:scenarioId}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Verify / CI (Legacy admission)",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "all",
        "--backend",
        "legacy",
        "--ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Verify Target Host",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
        "all",
        "--backend",
        "target"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run Selected Test",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-B",
        "${workspaceFolder}/telephony_core_service/services/multisim/test/scripts/test.py",
