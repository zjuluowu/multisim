        "LIFE-001",
        "DUAL-001",
        "RIL-001"
      ],
      "approval": "PUBLIC_TYPE_CONTRACT"
    },
    {
      "id": "PIN-RESULT",
      "level": "A",
      "source": "sim_state_type.h UnlockResult comments and LockStatusResponse",
      "meaning": "Password error maps to UNLOCK_INCORRECT; success maps to UNLOCK_OK; remaining attempts remain externally observable",
      "code_evidence": "SimStateManager::UnlockPin; SimStateHandle::GetUnlockResult",
      "scenarios": [
        "LOCK-001"
      ],
      "approval": "PUBLIC_TYPE_CONTRACT"
    },
    {
      "id": "PIN-INTERMEDIATE",
      "level": "C",
      "source": "services/sim/src/sim_state_manager.cpp:197",
      "meaning": "Successful PIN completion changes locked to not_ready before a separate ready status report",
      "scenarios": [],
      "approval": "SOURCE_OBSERVED_NOT_BUSINESS_APPROVED",
      "diagnostic_only": true
    },
    {
      "id": "SLOT-ISOLATION",
      "level": "D",
      "source": "design INV-01 and per-slot query/event signatures",
      "meaning": "A status change for one physical card must not change the unrelated card state",
      "scenarios": [],
      "approval": "NEEDS_DECISION_FOR_GENERALIZED_INVARIANT",
      "diagnostic_only": true
    },
    {
      "id": "RIL-PRESERVE",
      "level": "C",
      "source": "SimStateHandle::GetSimCardData and ProcessIccCardState",
      "meaning": "In the selected generic physical configuration, query errors leave observed state unchanged and repeated identical status keeps the same final state",
      "scenarios": [],
      "approval": "SOURCE_OBSERVED_NOT_BUSINESS_APPROVED",
      "limit": "No universal exact notification-count assertion; VSIM/product branches require separate scenarios",
      "diagnostic_only": true
    },
    {
      "id": "STALE-REJECT",
      "level": "D",
      "source": "design INV-02 and current task defect-regression requirement",
      "meaning": "An obsolete READY response must not resurrect a card removed since that request",
      "scenarios": [
        "DEFECT-001"
      ],
      "approval": "NEEDS_DECISION_ON_REQUEST_GENERATION_CONTRACT",
      "limit": "Defect candidate, never old-behavior compatibility; preserve failure evidence"
    },
    {
      "id": "NEZHA-I-R",
      "level": "D",
      "source": "design I1-I8 and R-1 through R-9",
      "meaning": "Product-specific activation, tray, role, persistence, timing and Profile candidate rules",
