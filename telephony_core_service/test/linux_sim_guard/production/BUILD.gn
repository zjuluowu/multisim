import("//build/lsg.gni")
import("//production/sources.gni")

config("production_headers") {
  include_dirs = []
  foreach(d, lsg_production_include_dirs) {
    include_dirs += [ "$lsg_prod/$d" ]
  }
}

config("production_defines") {
  defines = [
    "LOG_TAG=\"CoreService\"",
    "LOG_DOMAIN=0xD001F04",
    "OPENSSL_SUPPRESS_DEPRECATED",
  ]
}

# The code under test. Compiled from the unmodified tree at lsg_production_root,
# without -fno-access-control and without any test-only macro.
static_library("sim_production") {
  configs += [
    ":production_headers",
    ":production_defines",
    "//build/config:no_rtti",
    "//build/config:coverage",
    "//third_party:platform_headers",
  ]
  cflags_cc = [
    "-w",
    "-Wno-c++11-narrowing",
  ]
  sources = []
  foreach(s, lsg_sim_sources + lsg_support_sources) {
    sources += [ "$lsg_prod/$s" ]
  }
  public_configs = [
    ":production_headers",
    ":production_defines",
    "//third_party:platform_headers",
  ]
  deps = [ "//third_party:platform" ]
  libs = [
    "$lsg_deps/sysroot_extra/usr/lib/x86_64-linux-gnu/libcrypto.a",
    "xml2",
  ]
}
