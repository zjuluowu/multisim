import("//build/lsg.gni")

config("gtest_config") {
  include_dirs = [
    "$lsg_deps/googletest/googletest/include",
    "$lsg_deps/googletest/googlemock/include",
  ]
}

static_library("gtest") {
  testonly = true
  configs += [ "//build/config:third_party_warnings" ]
  include_dirs = [
    "$lsg_deps/googletest/googletest",
    "$lsg_deps/googletest/googlemock",
  ]
  public_configs = [ ":gtest_config" ]
  sources = [
    "$lsg_deps/googletest/googlemock/src/gmock-all.cc",
    "$lsg_deps/googletest/googletest/src/gtest-all.cc",
  ]
}
