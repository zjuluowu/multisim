declare_args() {
  # Absolute path of the dependency cache prepared by tools/fetch_deps.py.
  lsg_deps_root = ""

  # Absolute path of the telephony_core_service tree under test.
  lsg_production_root = ""

  lsg_cc = "clang-18"
  lsg_cxx = "clang++-18"
  lsg_ar = "llvm-ar-18"

  # Source based coverage for production sources (audit only, never an oracle).
  lsg_coverage = false
}

assert(lsg_deps_root != "", "set lsg_deps_root (see tools/run.py)")
assert(lsg_production_root != "", "set lsg_production_root (see tools/run.py)")

lsg_deps = lsg_deps_root
lsg_prod = lsg_production_root
