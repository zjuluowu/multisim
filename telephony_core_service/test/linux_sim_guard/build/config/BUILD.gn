import("//build/lsg.gni")

config("compiler") {
  cflags = [
    "-fPIC",
    "-g",
    "-O1",
    "-fno-omit-frame-pointer",
    "-pthread",
  ]
  cflags_cc = [ "-std=c++17" ]
  ldflags = [ "-pthread" ]
  libs = [ "dl" ]
  if (lsg_coverage) {
    ldflags += [
      "-fprofile-instr-generate",
      "-fcoverage-mapping",
    ]
  }
}

# Toolchain compatibility only: the OHOS libc++/musl headers include more standard
# headers transitively than glibc/libstdc++ do, and a few musl extensions are used.
config("host_compat") {
  include_dirs = [ "//env/compat" ]
  cflags_cc = [
    "-include",
    rebase_path("//env/compat/prelude.h", root_build_dir),
  ]
}

config("third_party_warnings") {
  cflags = [ "-w" ]
  cflags_cc = [ "-Wno-c++11-narrowing" ]
}

config("no_rtti") {
  cflags_cc = [ "-fno-rtti" ]
}

config("coverage") {
  if (lsg_coverage) {
    cflags = [
      "-fprofile-instr-generate",
      "-fcoverage-mapping",
    ]
  }
}
