config("production_headers") {
  include_dirs = [ "stubs/include" ]
  foreach(dir,
          [
            "services/sim/include",
            "interfaces/innerkits/include",
            "interfaces/innerkits/ims/include",
            "interfaces/innerkits/satellite",
            "services/tel_ril/include",
            "services/network_search/include",
            "services/core/include",
            "services/telephony_ext_wrapper/include",
            "utils/common/include",
            "utils/log/include",
            "utils/preferences/include",
            "common/capability_mgr/include",
          ]) {
    include_dirs += [ "$production_root/$dir" ]
  }
  include_dirs += [ "/usr/include/libxml2" ]
  defines = [ "LOG_DOMAIN=0xD001F04" ]
}
config("production_execution_evidence") {
  cflags_cc = [
    "-fprofile-instr-generate",
    "-fcoverage-mapping",
  ]
}

# Original implementation sources, not copied and not mixed with fixtures/stubs.
source_set("sim_production_host") {
  sources = [
    "$production_root/services/sim/src/sim_manager.cpp",
    "$production_root/services/telephony_ext_wrapper/src/telephony_ext_wrapper.cpp",
  ]
  configs += [
    ":production_headers",
    ":production_execution_evidence",
  ]
}
source_set("platform_boundaries") {
  sources = [ "stubs/parameter_service.cpp" ]
  include_dirs = [
    "stubs/include",
    "$gtest_root/googletest/include",
    "$gtest_root/googlemock/include",
  ]
}
source_set("external_service_boundaries") {
  sources = [ "stubs/external_services.cpp" ]
  include_dirs = [
    "stubs",
    "stubs/include",
    "$gtest_root/googletest/include",
    "$gtest_root/googlemock/include",
  ]
}
source_set("component_launcher") {
  sources = [ "support/capacity_probe.cpp" ]
  configs += [ ":production_headers" ]
}
static_library("googletest") {
  sources = [ "$gtest_root/googletest/src/gtest-all.cc" ]
  include_dirs = [
    "$gtest_root/googletest/include",
    "$gtest_root/googletest",
  ]
}
static_library("googlemock") {
  sources = [ "$gtest_root/googlemock/src/gmock-all.cc" ]
  include_dirs = [
    "$gtest_root/googlemock/include",
    "$gtest_root/googlemock",
    "$gtest_root/googletest/include",
  ]
  deps = [ ":googletest" ]
}
executable("sim_component_test") {
  sources = [ "tests/capacity_test.cpp" ]
  include_dirs = [
    "$gtest_root/googletest/include",
    "$gtest_root/googlemock/include",
    "support",
    "stubs",
  ]
  deps = [
    ":component_launcher",
    ":googlemock",
    ":platform_boundaries",
    ":sim_production_host",
  ]
  ldflags = [
    "-Wl,-Map,sim_component_test.map",
    "-fprofile-instr-generate",
  ]
}

config("initialization_standard_headers") {
  if (openssl_root != "") {
    include_dirs = [
      "$openssl_root/usr/include",
      "$openssl_root/usr/include/x86_64-linux-gnu",
    ]
  }
  cflags_cc = [
    "-include",
    rebase_path("stubs/include/host_standard_prelude.h", root_build_dir),
  ]
}

