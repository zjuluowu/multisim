+    struct OwnedThread {std::unique_ptr<ffrt::thread> handle;std::weak_ptr<Ticket> completion;};
+    std::vector<OwnedTask> tasks_;
+    std::vector<OwnedThread> threads_;
+    mutable ffrt::mutex mutex_; ffrt::condition_variable changed_;
