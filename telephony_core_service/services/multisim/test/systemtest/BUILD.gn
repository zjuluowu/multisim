config("production_headers") {
  include_dirs = [ "stubs/include" ]
  foreach(dir,
          [
            "services/sim/include",
            "interfaces/innerkits/include",
            "interfaces/innerkits/ims/include",
            "interfaces/innerkits/satellite",
            "services/tel_ril/include",
            "services/network_search/include",
            "services/core/include",
            "services/telephony_ext_wrapper/include",
            "utils/common/include",
            "utils/log/include",
            "utils/preferences/include",
            "common/capability_mgr/include",
          ]) {
    include_dirs += [ "$production_root/$dir" ]
  }
  include_dirs += [ libxml2_include_dir ]
  defines = [ "LOG_DOMAIN=0xD001F04" ]
}
config("production_execution_evidence") {
  cflags_cc = [
    "-fprofile-instr-generate",
    "-fcoverage-mapping",
  ]
}

# Primary-slot entry contract. ISimManager is an explicit internal seam here;
# this target MUST NOT be reported as full Controller/Radio/RIL execution.
config("primary_slot_headers") {
  include_dirs = [ "primary_slot/include", "primary_slot" ]
}
source_set("primary_slot_entry_production") {
