declare_args() {
  host_debug = false  # IDE host builds keep DWARF; legacy runners retain their profile.
  primary_slot_core_source = ""  # Optional negative-control copy outside the source tree.
  gtest_root = ""
  production_root = ""
  sim_guard_state_source =
      ""  # controlled mutation copy; normal runs always leave empty
  sim_guard_manager_source =
      ""  # controlled PIN hook mutation copy; normal runs leave empty
  openssl_root = ""
  libxml2_include_dir = "/usr/include/libxml2"
}
assert(gtest_root != "", "Pass a verified, pinned GoogleTest source directory")
assert(production_root != "",
       "Pass the current unmodified Core repository directory")
set_default_toolchain("//gn:linux")
set_defaults("source_set") {
  testonly = true
  configs = [ "//gn:host" ]
}
set_defaults("static_library") {
  testonly = true
  configs = [ "//gn:host" ]
}
set_defaults("executable") {
  testonly = true
  configs = [ "//gn:host" ]
}
