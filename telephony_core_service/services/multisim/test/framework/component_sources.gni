import("../../../../sim_legacy_sources.gni")

# Shared source ownership; each platform compiles its own objects.
sim_core_root = get_path_info("../../../..", "abspath")
sim_state_base_sources = [
  "$sim_core_root/frameworks/native/src/core_manager_inner.cpp",
  "$sim_core_root/services/sim/src/icc_state.cpp",
  "$sim_core_root/services/tel_ril/src/observer_handler.cpp",
]
sim_state_manager_source =
    "$sim_core_root/services/sim/src/sim_state_manager.cpp"
sim_state_handle_source = "$sim_core_root/services/sim/src/sim_state_handle.cpp"
sim_event_sources = [
  "$sim_core_root/utils/common/src/tel_event_handler.cpp",
  "$sim_core_root/utils/common/src/tel_event_queue.cpp",
]
sim_wrapper_sources = [
  "$sim_core_root/services/telephony_ext_wrapper/src/telephony_ext_wrapper.cpp",
]

sim_initialization_sources = filter_exclude(
        sim_legacy_core_sources,
        [
          "*/multi_sim_controller.cpp",
          "*/sim_manager.cpp",
        ])

sim_primary_support_sources = [
  "$sim_core_root/frameworks/native/src/core_manager_inner.cpp",
  "$sim_core_root/frameworks/native/src/operator_config_types.cpp",
  "$sim_core_root/services/core/src/core_service_hisysevent.cpp",
  "$sim_core_root/services/tel_ril/src/observer_handler.cpp",
  "$sim_core_root/utils/common/src/str_convert.cpp",
  "$sim_core_root/utils/common/src/telephony_common_utils.cpp",
]

# Controlled external component model shared by Linux and native component tests.
# POSIX scheduling/thread accounting + fake SDK/IPC declarations are intentional
# external boundaries. They do not establish compatibility with product SDK ABI.
sim_component_root = get_path_info(".", "abspath")
sim_parameter_model_sources =
    [ "$sim_component_root/internal/host/stubs/parameter_service.cpp" ]
sim_external_model_sources =
    [ "$sim_component_root/internal/host/stubs/external_services.cpp" ]
sim_scheduler_model_sources = [
  "$sim_component_root/internal/host/stubs/detached_threads.cpp",
  "$sim_component_root/internal/host/stubs/event_handler_runtime.cpp",
  "$sim_component_root/internal/host/stubs/ffrt_runtime.cpp",
]
