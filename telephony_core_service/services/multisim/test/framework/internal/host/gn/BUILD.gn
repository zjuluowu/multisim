config("host") {
  include_dirs = [
    "$gtest_root/googlemock/include",
    "$gtest_root/googletest/include",
  ]
  defines = [
    "SIM_HAS_LLVM_PROFILE",
    "SIM_PROFILE_DEFAULT=\"" + get_path_info(root_build_dir, "abspath") +
        "/profiles/direct-%p.profraw\"",
  ]
  cflags_cc = [
    "-std=c++17",
    "-flto=full",
    "-fwhole-program-vtables",
    "-fvirtual-function-elimination",
    "-fvisibility=hidden",
    "-ffunction-sections",
    "-fdata-sections",
  ]
  if (host_tsan) {
    cflags_cc += [ "-fsanitize=thread" ]
  }
  if (host_debug) {
    cflags_cc += [
      "-O1",
      "-g",
      "-fno-omit-frame-pointer",
    ]
  } else {
    cflags_cc += [ "-O2" ]
  }
  ldflags = [
    "-flto=full",
    "-fuse-ld=gold",
    "-Wl,--gc-sections",
    "-pthread",
  ]
  if (host_tsan) {
    ldflags += [ "-fsanitize=thread" ]
  }
}
toolchain("linux") {
  tool("cxx") {
    command = "clang++ {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -MMD -MF {{output}}.d -c {{source}} -o {{output}}"
    depfile = "{{output}}.d"
    depsformat = "gcc"
    outputs =
        [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    description = "CXX {{source}}"
  }
  tool("alink") {
    command = "ar rcs {{output}} {{inputs}}"
    outputs = [ "{{target_out_dir}}/lib{{target_output_name}}.a" ]
    default_output_extension = ".a"
    output_prefix = "lib"
  }
  tool("link") {
    command = "clang++ {{ldflags}} -o {{output}} {{inputs}} {{libs}}"
    outputs = [ "{{root_out_dir}}/{{target_output_name}}" ]
    description = "LINK {{output}}"
  }
  tool("solink") {
    command =
        "clang++ -shared -fPIC {{ldflags}} -o {{output}} {{inputs}} {{libs}}"
    outputs = [ "{{root_out_dir}}/lib{{target_output_name}}.so" ]
    link_output = "{{root_out_dir}}/lib{{target_output_name}}.so"
    depend_output = "{{root_out_dir}}/lib{{target_output_name}}.so"
    output_prefix = ""
    default_output_extension = ".so"
  }
  tool("stamp") {
    command = "touch {{output}}"
  }
}
