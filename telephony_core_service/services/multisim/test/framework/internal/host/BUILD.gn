test_root = "$production_root/services/multisim/test"
import("../../../cases/sources.gni")
import("../../component_sources.gni")
config("production_headers") {
  include_dirs = [ "$test_root/framework/internal/host/stubs/include" ]
  foreach(dir,
          [
            "services/sim/include",
            "interfaces/innerkits/include",
            "interfaces/innerkits/ims/include",
            "interfaces/innerkits/satellite",
            "services/tel_ril/include",
            "services/network_search/include",
            "services/core/include",
            "services/telephony_ext_wrapper/include",
            "utils/common/include",
            "utils/log/include",
            "utils/preferences/include",
            "common/capability_mgr/include",
          ]) {
    include_dirs += [ "$production_root/$dir" ]
  }
  include_dirs += [ libxml2_include_dir ]
  defines = [ "LOG_DOMAIN=0xD001F04" ]
}
config("production_execution_evidence") {
  cflags_cc = [
    "-fprofile-instr-generate=" + get_path_info(root_build_dir, "abspath") +
        "/profiles/direct-%p.profraw",
    "-fcoverage-mapping",
  ]
}
config("target_production_headers") {
  include_dirs = [ "$production_root/services/multisim" ]
}

# Executable Target slice. It is linked only to Target-owned production code;
# unimplemented service/persistence/device closure remains explicitly BLOCKED in
# backend_capabilities.json rather than being supplied by Legacy or a fake SUT.
static_library("sim_target_production_host") {
  sources = [
    "$production_root/services/multisim/infrastructure/assembly/slot_catalog.cpp",
    "$production_root/services/multisim/account/account_registry.cpp",
    "$production_root/services/multisim/account/binding_index.cpp",
    "$production_root/services/multisim/account/discovery/discovery_observation_ledger.cpp",
    "$production_root/services/multisim/account/activation/activation_progress.cpp",
    "$production_root/services/multisim/account/topology_service.cpp",
    "$production_root/services/multisim/role_assignment/assignment_aggregate.cpp",
    "$production_root/services/multisim/role_assignment/assignment_service.cpp",
    "$production_root/services/multisim/role_assignment/assignment_store_adapter.cpp",
    "$production_root/services/multisim/role_assignment/primary/primary_switch_plan.cpp",
  ]
  configs += [
    ":target_production_headers",
    ":production_execution_evidence",
  ]
}
executable("sim_test_target_host") {
  sources = [
    "$test_root/cases/target/architecture/primary_plan_test.cpp",
    "$test_root/cases/target/primary/c0_assignment_service_test.cpp",
    "$test_root/cases/target/primary/c0_store_adapter_integration_test.cpp",
    "$test_root/cases/target/primary/c0_topology_integration_test.cpp",
  ]
  configs += [ ":target_production_headers" ]
  include_dirs = [ "$gtest_root/googletest/include" ]
  deps = [
    ":googlemock",
    ":sim_target_production_host",
    ":test_entry",
  ]
  ldflags = [
    "-fprofile-instr-generate=" + get_path_info(root_build_dir, "abspath") +
        "/profiles/direct-%p.profraw",
    "-Wl,-Map,sim_test_target_host.map",
  ]
}

# Primary-slot entry contract. ISimManager is an explicit internal seam here;
# this target MUST NOT be reported as full Controller/Radio/RIL execution.
