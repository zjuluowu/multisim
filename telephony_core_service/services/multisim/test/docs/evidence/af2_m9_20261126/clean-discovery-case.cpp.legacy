#include <gtest/gtest.h>
#include "device/resource/resource_barrier.h"

TEST(HandoffDiscovery, TargetCppIsAutomaticallyBuilt)
{
    using namespace OHOS::Telephony::MultiSim;
    ResourceBarrier barrier({1, 2});
    const ResourceKey key {"handoff-fixture"};
    ASSERT_TRUE(barrier.RegisterForInitialCheck(key));
    EXPECT_EQ(barrier.ReadState(key), ResourceState::Checking);
}
