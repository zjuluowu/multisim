+        auto response=std::make_shared<RadioProtocol>();response->slotId=slot;response->modemId=slot;
+        response->technology=slot==0?0x11:0x22;
+        RealScenario::Reply({slot,event->GetOwner(),event->GetInnerEventId()},response);return 0;
+    });
+    s.manager->GetRadioProtocol(0);s.manager->GetRadioProtocol(1);
+    const auto deadline=std::chrono::steady_clock::now()+3s;
+    while(s.manager->GetRadioProtocolSlotIdByModemId(1)!=1 && std::chrono::steady_clock::now()<deadline)
+        std::this_thread::yield();
+    ASSERT_EQ(s.manager->GetRadioProtocolSlotIdByModemId(1),1);
+    EXPECT_CALL(*s.ril,SetRadioProtocol(testing::_,testing::_,testing::_)).Times(22)
+        .WillRepeatedly([&](int slot,RadioProtocol protocol,const auto &event) {
+            {std::lock_guard<std::mutex> lock(s.mutex);
+             ++requests;phases[protocol.sessionId].emplace_back(slot,protocol.phase);}
+            std::cout<<"TIMEOUT_RETRY session="<<protocol.sessionId<<" phase="<<static_cast<int>(protocol.phase)
