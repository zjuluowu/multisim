+namespace SimHost {
+namespace {
+std::mutex logObserverMutex;
+std::function<void(const std::string &)> logObserver;
+std::atomic_bool hasLogObserver{false};
+}
+bool HasLogObserver() {return hasLogObserver.load();}
+void SetLogObserver(std::function<void(const std::string &)> observer) {
+    std::lock_guard<std::mutex> lock(logObserverMutex);
+    logObserver=std::move(observer);hasLogObserver=bool(logObserver);
+}
+void ObserveHostLog(const std::string &line) {
+    if (!hasLogObserver.load(std::memory_order_acquire)) return;
+    std::function<void(const std::string &)> observer;
+    {std::lock_guard<std::mutex> lock(logObserverMutex);observer=logObserver;}
+    if(observer)observer(line); // No registry lock across a test barrier.
+}
