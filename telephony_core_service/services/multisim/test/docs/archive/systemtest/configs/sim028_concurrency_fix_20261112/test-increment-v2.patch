+namespace {
+struct HandoffState {
+    std::mutex mutex;std::condition_variable changed;
+    bool paused=false,release=false,producerStarted=false,producerDone=false,delivered=false;
+};
+class HandoffHandler final : public OHOS::Telephony::TelEventHandler {
+public:
+    explicit HandoffHandler(std::shared_ptr<HandoffState> state)
+        : TelEventHandler("QueueHandoffRegression"),state_(std::move(state)) {}
+    void ProcessEvent(const OHOS::AppExecFwk::InnerEvent::Pointer &event) override {
+        if(event->GetInnerEventId()==3) {
+            std::lock_guard<std::mutex> lock(state_->mutex);state_->delivered=true;state_->changed.notify_all();
+        }
+    }
+private:std::shared_ptr<HandoffState> state_;
+};
+TEST(ConcurrencyRegression, QueueHandoffDoesNotDelayImmediateEvent)
+{
+    auto state=std::make_shared<HandoffState>();
+    auto handler=std::make_shared<HandoffHandler>(state);
+    ASSERT_TRUE(handler->SendEvent(2,45000)); // Retain real long-delay work behind the initial event.
+    SimHost::SetLogObserver([state](const std::string &line) {
+        if(line.find("SIM028_QUEUE_HANDOFF name=QueueHandoffRegression")==std::string::npos ||
+           line.find("delay_us=4")==std::string::npos)return;
+        std::unique_lock<std::mutex> lock(state->mutex);
+        if(state->paused)return;
+        state->paused=true;state->changed.notify_all();state->changed.wait(lock,[&]{return state->release;});
+    });
+    EXPECT_TRUE(handler->SendEvent(1));
+    bool paused;
+    {std::unique_lock<std::mutex> lock(state->mutex);paused=state->changed.wait_for(lock,3s,[&]{return state->paused;});}
+    std::thread producer([handler,state] {
+        {std::lock_guard<std::mutex> lock(state->mutex);state->producerStarted=true;state->changed.notify_all();}
+        EXPECT_TRUE(handler->SendEvent(3));
+        {std::lock_guard<std::mutex> lock(state->mutex);state->producerDone=true;state->changed.notify_all();}
+    });
+    bool insertedWhilePaused=false;
+    {std::unique_lock<std::mutex> lock(state->mutex);
+     EXPECT_TRUE(state->changed.wait_for(lock,3s,[&]{return state->producerStarted;}));
+     // A bounded observation rendezvous, not a sleep or a business deadline change.
+     insertedWhilePaused=state->changed.wait_for(lock,200ms,[&]{return state->producerDone;});
+     state->release=true;state->changed.notify_all();}
+    producer.join();SimHost::SetLogObserver({});
+    bool delivered;
+    {std::unique_lock<std::mutex> lock(state->mutex);delivered=state->changed.wait_for(lock,1s,[&]{return state->delivered;});}
+    EXPECT_TRUE(paused);EXPECT_TRUE(delivered) << "IMMEDIATE_EVENT_STRANDED_BEHIND_STALE_45S_SNAPSHOT";
+    testing::Test::RecordProperty("producer_inserted_during_handoff",insertedWhilePaused?"true":"false");
+    EXPECT_TRUE(handler->StopEvents());std::weak_ptr<HandoffHandler> weak=handler;handler.reset();
+    EXPECT_TRUE(weak.expired());EXPECT_TRUE(SimHost::AwaitSchedulerStopped(3s));
+}
+TEST(ConcurrencyRegression, CrossQueueStateSnapshotsAndSetter)
+{
+    auto handle=std::make_shared<OHOS::Telephony::SimStateHandle>(std::weak_ptr<OHOS::Telephony::SimStateManager>{});
+    handle->SetSimState(OHOS::Telephony::SimState::SIM_STATE_UNKNOWN);
+    std::promise<void> start;auto ready=start.get_future().share();std::atomic_uint reads{0};
+    std::thread writer([&] {ready.wait();for(int i=0;i<20000;++i)
+        handle->SetSimState(i%2?OHOS::Telephony::SimState::SIM_STATE_READY:OHOS::Telephony::SimState::SIM_STATE_LOCKED);});
+    std::thread reader([&] {ready.wait();for(int i=0;i<20000;++i) {
+        auto state=handle->GetSimState();EXPECT_TRUE(state==OHOS::Telephony::SimState::SIM_STATE_UNKNOWN ||
+            state==OHOS::Telephony::SimState::SIM_STATE_READY || state==OHOS::Telephony::SimState::SIM_STATE_LOCKED);++reads;}});
+    start.set_value();writer.join();reader.join();EXPECT_EQ(reads.load(),20000u);
+    EXPECT_TRUE(handle->StopEvents());std::weak_ptr<OHOS::Telephony::SimStateHandle> weak=handle;handle.reset();
+    EXPECT_TRUE(weak.expired());EXPECT_TRUE(SimHost::AwaitSchedulerStopped(3s));
+}
