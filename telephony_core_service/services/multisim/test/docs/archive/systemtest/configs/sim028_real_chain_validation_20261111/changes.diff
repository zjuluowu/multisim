+        response->index = slot; response->simType = ICC_USIM_TYPE;
+        response->simState = slot == 1 ? ICC_CONTENT_PIN : ICC_CARD_ABSENT;
+        response->iccid = slot == 1 ? "8900000000000000001" : "";
