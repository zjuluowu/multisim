  "findings": [
    {
      "id": "R01",
      "severity": "BLOCKER",
      "location": "services/core/src/core_service.cpp:146-158 (unchanged baseline)",
      "finding": "OnStop当前只停止IMS/NetworkSearch后DeInit共享RIL，未调用真实SimManager Stop。现候选没有产品生命周期调用点。",
      "decision": "由Core控制线程关闭新入口，持有同一控制块typed/weak生命周期hook；Stop失败不得继续释放根/DeInit RIL。不得另造Manager或改写ISimManager错误协议。"
    },
    {
      "id": "R02",
      "severity": "BLOCKER",
      "location": "multi_sim_monitor.cpp UnSubscribeListeners / SystemAbilityStatusChangeListener / CES/death handlers",
      "finding": "SA退订返回码仍忽略；先weak.lock后Lease会在被拒绝前取得临时强引用；CES Hub原生完成屏障未验证。Host没有成功CES/SA订阅。",
      "decision": "持有注册账本、确认失败重试；在weak锁对象前先进入外部回调上下文屏障；若平台能证明注销为同步屏障，提供匹配实现证据和竞争测试。"
    },
    {
      "id": "R03",
      "severity": "ARCHITECTURE",
      "location": "utils/common/include/tel_lifecycle.h CurrentOrNew / Context / Lease",
      "finding": "按逻辑任务隐式向所有新TelEventQueue传播组；同进程其他消费者/跨SO构造可能被错误纳入。Host单二进制不证明原生链接唯一性。",
      "decision": "裁决显式组归属注入或严格组件边界；验证NetworkSearch/SMS/其他Core消费者不受Sim Stop误封闭。"
    },
    {
      "id": "R04",
      "severity": "ARCHITECTURE",
      "location": "tel_lifecycle.h Lease Kind::Business / Reserve",
      "finding": "nested business标记等同延续许可，没有request/epoch身份；同任务外部重入新请求可能被视为已接纳延续。当前测试拒绝的是另一调用线程的新请求。",
      "decision": "区分根业务准入与内部已接纳延续，选择显式许可或原生不可重入前提；不得靠假设所有回调都为新线程通过审查。"
    },
    {
      "id": "R05",
      "severity": "BLOCKER",
      "location": "SimManager::Stop / JoinOwnedWork / TelEventQueue::Stop / TelStopOnce::Run",
      "finding": "75秒仅覆盖部分CV等待；join、queue wait、外部注销及子Stop等待不共享完整截止时间。无在途时才回收句柄，持续繁忙峰值未验证。",
      "decision": "明确Stop失败/可重试/最大等待契约、统一预算或有证据的完成界限；压力与永久阻塞负控不可缺少。"
    },
    {
      "id": "R06",
      "severity": "BLOCKER",
      "location": "RebootDetectCallback / SimFile ApplySatelliteParameter / TelParameterWatcher",
      "finding": "Lease提供计数屏障而非业务串行化。Native参数服务两键或同键并发调用时，hasCheckedSimPresent_/sateState_的访问需要真实并发模型。",
      "decision": "平台提供串行保证或在对象层串行化；若改为投递队列，先裁决正常通知/状态偏序，不能为测试方便改变同步语义。"
    },
    {
      "id": "R07",
      "severity": "NATIVE_VALIDATION",
      "location": "SimManager destructor / SimStateManager destructor / leaf Shutdown",
      "finding": "完整Root退出以显式Stop为前提，析构只记录遗漏。现PartialInit为null-RIL子初始化；未覆盖全部分配失败、正常初始化中断、叶子并发Shutdown。",
      "decision": "定义Core Init失败后的同一退出路径；Stopped实例不可复用，只支持新对象重新装配；原生部分注册失败、重入析构、叶子并发补测。"
    },
    {
      "id": "R08",
      "severity": "NATIVE_VALIDATION",
      "location": "operator_config_cache.cpp / cached Records / C1 retry chain",
      "finding": "APN RemoveTask只编译；缓存卡类型切换、多轮无应答/Stop预算失败后重试未执行；不能以96/ASan/TSan Host结果覆盖。",
      "decision": "保留NOT_RUN，按README原生计划补齐；真实FFRT/HDI/SA及其他RIL消费者必须独立验收。"
    },
    {
      "id": "R09",
      "severity": "ABI",
      "location": "IccFile::Shutdown virtual + lifecycle fields in internal classes",
      "finding": "未改变ISimManager/IDL，但内部布局和vtable变化不能与旧对象/插件混装；所有权与stop错误返回属于新增运行契约。",
      "decision": "整体产品重编及厂商扩展兼容性回归；运行态已有返回/参数暂存恢复/通知时机保持源码断言，停止态错误码需明确接纳。"
    },
    {
      "id": "R10",
      "severity": "TEST_PORTABILITY",
      "location": "real_scenario.h / shutdown_contract.h / compile_declarations.h",
      "finding": "硬编码3逻辑对象、2设备成员、RTTI mangled角色名、Host Provider内存行、共享运行时模型只在该fixture成立。",
      "decision": "保留真实业务断言，抽离输入/观察适配；Native使用实际SlotCatalog/原生类型与参数/服务，不链接Host替身；Runtime生命周期测试不得链接ffrt_mocked。"
    },
    {
      "id": "R11",
      "severity": "BLOCKER",
      "location": "primary_slot/real_test.cpp C1CheckFailureRestoresParametersAndExhaustsFiveRetries; radio_protocol_controller.cpp completion/cleanup ordering",
      "finding": "Actual incremental ASan run reached session3 CHECK then failed unchanged 12s/24-request assertion. Fatal return destroyed phases before scenario Stop; later COMPLETE accessed destroyed map (ASan exit86).",
      "decision": "Test patch moves callback state before RealScenario so teardown drains while state valid. Retry liveness root remains unproven; preserve FAIL and investigate separately without unauthorized production change; no timeout increase or passing rerun erases failure."
    },
    {
      "id": "R12",
      "severity": "BLOCKER",
      "location": "services/sim/src/sim_state_handle.cpp:897 IsIccReady / :910 SimStateEscape; RegisterCoreNotify:1057; MultiSimMonitor::RegisterSimNotify",
      "finding": "Fresh split-candidate TSan run BDirectRilFailureKeepsPreviousPrimary exited87: StateHandle queue writes externalState_ while Monitor queue reads same address via RegisterCoreNotify->IsIccReady, with no common synchronization. Actual full stacks archived. These running-path accesses also exist in baseline; this run does not establish introduction by Stop patch.",
      "decision": "Do not whitelist as sixth known failure, serialize or synchronize all state accesses with established state/notification ordering in a separately authorized production fix. Need native delivery order and locking/reentrancy review, not blanket shared_ptr/atomic conversion."
    }
  ],
